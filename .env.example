# Leave empty to use the Vite dev proxy (/api → Laravel). Recommended for Docker.
NUXT_PUBLIC_API_BASE=

# Proxy target (Nuxt dev server → Laravel). Docker Compose sets http://backend:8000.
NUXT_API_PROXY_TARGET=http://127.0.0.1:8000

# Or call the API directly (requires CORS on Laravel):
# NUXT_PUBLIC_API_BASE=http://localhost:8000
